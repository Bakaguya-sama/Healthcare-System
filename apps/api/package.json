{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "worker:outbox": "ts-node -r tsconfig-paths/register src/worker.ts",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 402",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "boundary:check": "ts-node src/scripts/check-backend-boundary.ts",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "openapi:generate": "ts-node -r tsconfig-paths/register src/scripts/openapi-contract.ts",
    "openapi:check": "ts-node -r tsconfig-paths/register src/scripts/openapi-contract.ts --check",
    "realtime:generate": "ts-node -r tsconfig-paths/register src/scripts/realtime-contract.ts",
    "realtime:check": "ts-node -r tsconfig-paths/register src/scripts/realtime-contract.ts --check",
    "database:migrate": "ts-node -r tsconfig-paths/register src/database/migrations/run-migrations.ts",
    "database:verify": "ts-node -r tsconfig-paths/register src/database/verify-database.ts",
    "database:seed:reference": "ts-node -r tsconfig-paths/register src/database/seeds/reference.seed.ts",
    "database:seed:demo": "ts-node -r tsconfig-paths/register src/database/seeds/demo.seed.ts",
    "database:bootstrap": "pnpm run database:migrate && pnpm run database:verify && pnpm run database:seed:reference",
    "migration:up": "pnpm run database:migrate",
    "perf:rf2d": "ts-node -r tsconfig-paths/register src/scripts/rf2d-query-baseline.ts",
    "perf:rf2e": "ts-node -r tsconfig-paths/register src/scripts/rf2e-cache-baseline.ts",
    "seed": "pnpm run database:seed:demo",
    "seed:legacy": "ts-node -r tsconfig-paths/register src/seeds/seed.ts",
    "seed:build": "npm run build && node dist/database/seeds/demo.seed.js",
    "seed:legacy:build": "npm run build && node dist/seeds/seed.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@keyv/redis": "5.1.6",
    "@langchain/classic": "^1.0.24",
    "@langchain/community": "^1.1.24",
    "@langchain/core": "^1.1.34",
    "@langchain/google-genai": "^2.1.26",
    "@langchain/mongodb": "^1.1.0",
    "@langchain/textsplitters": "^1.0.1",
    "@llamaindex/llama-cloud": "^2.4.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.16",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.6.0",
    "@nestjs/websockets": "^11.1.16",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.7",
    "cache-manager": "7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "2.9.0",
    "helmet": "8.3.0",
    "iconv-lite": "^0.7.2",
    "jschardet": "^3.1.4",
    "keyv": "5.6.0",
    "langchain": "^1.2.35",
    "mammoth": "^1.12.0",
    "mongodb": "^7.1.0",
    "mongoose": "^9.3.0",
    "multer": "2.1.1",
    "nodemailer": "^8.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^2.4.5",
    "redis": "5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    }
  }
}
