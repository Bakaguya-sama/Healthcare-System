# Runtime
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# MongoDB — local replica set example, never put production credentials here
MONGODB_URI=mongodb://localhost:27017/healthcare_v2_local?replicaSet=rs0

# Authentication — replace locally; staging/production values belong in a secret manager
JWT_SECRET=replace-with-a-long-random-secret

# Redis — required by OTP, throttling, presence, quota and BullMQ
REDIS_URL=redis://localhost:6379

# Google AI
GEMINI_API_KEY=replace-with-gemini-api-key
LLAMA_CLOUD_API_KEY=replace-with-llama-cloud-api-key

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=no-reply@example.com

# Upload limits
MAX_IMAGES=5
MAX_CHAT_ATTACHMENTS=5
MAX_CHAT_ATTACHMENT_SIZE_BYTES=10485760
