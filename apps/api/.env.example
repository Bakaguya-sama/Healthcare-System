# Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1
SOCKET_PATH=/socket.io
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TRUST_PROXY=loopback
BODY_LIMIT=1mb
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# MongoDB — local replica set example, never put production credentials here
MONGODB_URI=mongodb://localhost:27018/healthcare_v2_local?replicaSet=rs0&directConnection=true

# Authentication — replace locally; staging/production values belong in a secret manager
JWT_SECRET=replace-with-a-long-random-secret

# Redis — required by OTP, throttling, presence, quota and BullMQ
REDIS_URL=redis://localhost:16379
REDIS_NAMESPACE=healthcare
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=1500

# Schema changes are migration-owned outside development/test
# Leave empty: true in development/test, false in staging/production
DB_AUTO_INDEX=
DB_AUTO_CREATE=
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
# Leave empty: 0 in development/test, latest registered migration otherwise
MIN_SCHEMA_VERSION=

# Google AI
GEMINI_API_KEY=replace-with-gemini-api-key
LLAMA_CLOUD_API_KEY=replace-with-llama-cloud-api-key

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=no-reply@example.com

# Upload limits
MAX_IMAGES=5
MAX_CHAT_ATTACHMENTS=5
MAX_CHAT_ATTACHMENT_SIZE_BYTES=10485760
MAX_FILE_SIZE=52428800

# Abuse protection (in-memory until the shared Redis foundation in RF-4)
# Leave empty to use the NODE_ENV default: off in development/test, on in staging/production.
# Set true/false explicitly only when an environment needs an override.
THROTTLE_ENABLED=
HTTP_THROTTLE_TTL_MS=60000
HTTP_THROTTLE_LIMIT=120
WS_THROTTLE_TTL_MS=10000
WS_THROTTLE_LIMIT=30
