OK
@startuml
autoactivate on
title Quản lý gói dịch vụ
actor Admin
boundary "Plan Management Page" as UI
control PlanController as C
control PlanService as S
database MongoDB as DB
Admin -> UI : Tạo hoặc cập nhật gói dịch vụ
UI -> UI : validatePlan(price, entitlements, limits)
UI -> C : POST/PATCH plans
C -> S : createOrUpdatePlan(planData)
S -> DB : Kiểm tra plan và quyền Admin
DB --> S : validation data
alt Plan không hợp lệ
 S --> C : Error
 C --> UI : errorResponse
 UI --> Admin : Hiển thị lỗi
else Hợp lệ
 S -> DB : Lưu Plan version mới
 DB --> S : saved plan
 S --> C : plan
 C --> UI : successResponse
 UI --> Admin : Hiển thị gói dịch vụ cập nhật
end
@enduml
