@startuml
autoactivate on
title Gửi lời mời người thân
actor "Bệnh nhân" as A
boundary "Family Link Page" as UI
control FamilyLinkController as C
control FamilyLinkService as S
database MongoDB as DB
actor "Notification Service" as N
A -> UI : Nhập tài khoản người thân và gửi lời mời
UI -> C : POST family links(invitee)
C -> S : createInvitation(invitee)
S -> DB : Kiểm tra user, consent và familyLinkLimit
DB --> S : validation result
alt Không hợp lệ hoặc vượt giới hạn
 S --> C : Error
 C --> UI : errorResponse
 UI --> A : Hiển thị lỗi
else Hợp lệ
 S -> DB : Lưu lời mời pending
 S -> N : sendInvitation(invitee)
 N --> S : delivered
 S --> C : invitation
 C --> UI : successResponse
 UI --> A : Hiển thị lời mời đã gửi
end
@enduml
