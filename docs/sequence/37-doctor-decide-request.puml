OK
@startuml
autoactivate on
title Chấp nhận hoặc từ chối yêu cầu tư vấn
actor "Bác sĩ" as A
boundary "Consultation Request Page" as UI
control ConsultationController as C
control ConsultationService as S
database MongoDB as DB
A -> UI : Chọn accept hoặc decline request
UI -> C : POST request action
C -> S : decideRequest(doctorId, action)
S -> DB : Kiểm tra ownership và trạng thái pending
DB --> S : request | error
alt Không hợp lệ
 S --> C : Error
 C --> UI : error
 UI --> A : Hiển thị lỗi
else Hợp lệ
 S -> DB : Cập nhật request và consultation status
 DB --> S : updated
 S --> C : success
 C --> UI : success
 UI --> A : Hiển thị kết quả
end
@enduml