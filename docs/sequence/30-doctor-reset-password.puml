OK
@startuml
autoactivate on
title Quên và đặt lại mật khẩu Bác sĩ

actor "Bác sĩ" as Doctor
boundary "Forgot Password Page" as UI
control AuthController as Controller
control AuthService as Service
database MongoDB as DB
actor "Email Service" as Mail

Doctor -> UI : Nhập email yêu cầu đặt lại
UI -> Controller : POST /auth/send-otp
Controller -> Service : issuePasswordResetOtp(email)
Service -> DB : Kiểm tra User
DB --> Service : User | null

alt Email không tồn tại
  Service --> Controller : Not found error
  Controller --> UI : errorResponse
  UI --> Doctor : Hiển thị lỗi
else Email tồn tại
  Service -> Mail : sendOtpEmail(email, otp)
  Mail --> Service : sent
  Service --> Controller : otpIssued
  Controller --> UI : Hiển thị form OTP và mật khẩu mới

  Doctor -> UI : Nhập OTP và mật khẩu mới
  UI -> Controller : POST /auth/change-password
  Controller -> Service : changePassword(otp, newPassword)
  Service -> DB : Xác minh OTP, cập nhật password hash, thu hồi session
  DB --> Service : updated

  alt OTP sai hoặc đã hết hạn
    Service --> Controller : Invalid/expired OTP error
    Controller --> UI : errorResponse
    UI --> Doctor : Hiển thị lỗi xác thực
  else Đặt lại thành công
    Service --> Controller : passwordChanged
    Controller --> UI : successResponse
    UI --> Doctor : Thông báo đổi mật khẩu thành công
  end
end
@enduml
