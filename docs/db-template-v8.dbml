Ref: PatientCarePrograms.doctorId > Users.id
Ref: PatientCarePrograms.careProgramId > CarePrograms.id
Ref: PatientCarePrograms.careRuleId > CareRules.id
Ref: PatientCarePrograms.cancelledBy > Users.id
Ref: PatientCarePrograms.createdBy > Users.id
Ref: CareTasks.patientCareProgramId > PatientCarePrograms.id
Ref: CareTasks.patientId > Users.id
Ref: CareTasks.doctorId > Users.id
Ref: HealthEvaluations.patientCareProgramId > PatientCarePrograms.id
Ref: HealthEvaluations.patientId > Users.id
Ref: HealthEvaluations.careTaskId > CareTasks.id
Ref: HealthEvaluations.healthMetricId > HealthMetrics.id
Ref: HealthEvaluations.careRuleId > CareRules.id
Ref: HealthEvaluations.replacesEvaluationId > HealthEvaluations.id
Ref: CareAlerts.patientCareProgramId > PatientCarePrograms.id
Ref: CareAlerts.evaluationId > HealthEvaluations.id
Ref: CareAlerts.patientId > Users.id
