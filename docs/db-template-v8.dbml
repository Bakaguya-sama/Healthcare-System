Ref: CareReports.patientId > Users.id
Ref: CareReports.careRuleId > CareRules.id
Ref: CareReports.replacesReportId > CareReports.id
Ref: CareSummaries.reportId > CareReports.id
Ref: CareSummaries.patientCareProgramId > PatientCarePrograms.id
Ref: CareSummaries.patientId > Users.id
Ref: CareSummaries.careRuleId > CareRules.id
Ref: CareSummaries.reviewedBy > Users.id
Ref: ConsultationUsages.userId > Users.id
Ref: ConsultationUsages.subscriptionId > Subscriptions.id
Ref: ConsultationUsages.consultationId > Consultations.id
